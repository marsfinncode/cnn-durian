<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_hitech">

    <!-- Clean Classic Center Logo & App Title -->
    <LinearLayout
        android:id="@+id/splashCenterContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <ImageView
            android:id="@+id/ivSplashLogo"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_app_logo" />

        <TextView
            android:id="@+id/tvSplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSplashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/splash_subtitle"
            android:textColor="#E8F5E9"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Minimal Clean Bottom Loading Bar, Logos & Version -->
    <LinearLayout
        android:id="@+id/splashBottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp">

        <ProgressBar
            android:id="@+id/progressSplash"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="160dp"
            android:layout_height="5dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_progress_confidence" />

        <!-- Bottom Logos: BUU and MWIT -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="22dp">

            <ImageView
                android:id="@+id/ivSplashLogoBuu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_buu"
                android:contentDescription="Burapha University" />

            <View
                android:layout_width="20dp"
                android:layout_height="1dp" />

            <ImageView
                android:id="@+id/ivSplashLogoMwit"
                android:layout_width="46dp"
                android:layout_height="49dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_mwit"
                android:contentDescription="Mahidol Wittayanusorn School" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSplashVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

</FrameLayout>
